// depth_check on so the bar is correctly occluded by terrain/the globe (it
// should never draw through scenery) - depth_write stays off since it's
// alpha-blended and shouldn't block the fill layer drawn just above it
material HEALTHBAR_BG
{
    technique
    {
        pass
        {
            lighting off
            depth_check on
            depth_write off
            scene_blend alpha_blend
            diffuse 0.05 0.05 0.05 0.85
            ambient 0.05 0.05 0.05 0.85
        }
    }
}
