vertex_program UnitVP glsl
{
    source unit_vp.glsl
}

fragment_program UnitFP glsl
{
    source unit_fp.glsl
}

material WHITE
{
    technique
    {
        pass
        {
            vertex_program_ref UnitVP
            {
		param_named_auto worldViewProj worldviewproj_matrix
            }
            fragment_program_ref UnitFP
            {
		shared_params_ref ViewerParams
                param_named_auto ownerID custom 0
            }
        }
    }
}